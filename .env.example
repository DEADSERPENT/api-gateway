# Copy to .env. Test keys only; never commit real secrets.
PORT=3000
SERVICE_A_URL=http://localhost:4001
SERVICE_B_URL=http://localhost:4002
REDIS_URL=redis://127.0.0.1:6379

JWT_ISSUER=https://issuer.test
JWT_AUDIENCE=api-gateway
# RS256 public key (SPKI PEM); newlines may be written as \n. `node scripts/dev-keys.mjs`
# generates a test pair and a ready-made .dev/gateway.env.
JWT_PUBLIC_KEY_PEM=

UPSTREAM_TIMEOUT_MS=3000
BODY_LIMIT_BYTES=1048576

BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_MS=10000
BREAKER_COOLDOWN_MS=5000
BREAKER_HALF_OPEN_PROBES=1

# Token bucket: burst size and sustained refill rate (tokens/second).
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=10
# closed = 503 when Redis is down (quotas never bypassed); open = keep serving unthrottled.
RATE_LIMIT_FAIL_POLICY=closed

# Optional: require "Authorization: Bearer <token>" on /metrics (min 16 chars).
METRICS_TOKEN=
