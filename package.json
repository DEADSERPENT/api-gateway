{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/src/server.js",
    "smoke": "bash scripts/smoke.sh",
    "audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high"
  },
  "dependencies": {
    "@fastify/reply-from": "12.8.1",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
